[general]
; Роль этого АРМ: client получает показания ИБП от АРМ1 по сети.
role = client
; Действие при разряде: off — выключить АРМ через rtcwake.
; mem — сон с сохранением памяти; disk — гибернация.
; standby/freeze — менее глубокий сон; monitor_only — погасить монитор.
; no — поставить RTC-будильник и отдельно выполнить systemctl poweroff.
; Команда для off/mem/disk/standby/freeze: rtcwake -m <action_mode> -s <wake_interval>.
action_mode = off
; Пробный режим: yes — только диагностика без RTC, сна, выключения и гашения монитора.
dry_run = yes
; Отправлять ли предупреждения пользователям через команду wall.
wall = yes
; Файл состояния для восстановления решения после перезапуска и RTC-пробуждения.
state_file = /var/lib/upsguard/state.json
; Файл журнала работы программы.
log_file = /var/log/upsguard.log

[nut]
; Имя ИБП и IP АРМ1. При установке MASTER_IP заменяется на указанный --master-ip.
ups = delta@MASTER_IP
; Период между опросами ИБП, секунды.
poll_interval = 2
; Максимальное время ожидания ответа NUT, секунды.
query_timeout = 5

[policy]
; Процент заряда от 0 до 100, при котором на батарее начинается подготовка действия.
charge_percent = 50
; Сколько секунд заряд должен оставаться не выше порога.
trigger_hold = 20
; Сколько секунд должен подтверждаться статус OB (работа от батареи).
ob_debounce = 5
; Сколько секунд должен подтверждаться статус OL (питание от сети).
ol_stable = 30
; Время на остановку службы перед выключением или сном, секунды.
; Не меньше 60 с и не меньше ol_stable + 15 с.
shutdown_grace = 120
; Время на остановку службы при статусе LB, секунды.
; Уже начатый более ранний отсчёт не продлевается.
lb_grace = 120
; Интервал до RTC-пробуждения, секунды. 900 = 15 минут.
; Допустимое значение не меньше 180 с.
wake_interval = 900
; Максимальное время проверки статуса после контрольной загрузки или пробуждения, секунды.
; Не меньше shutdown_grace + ob_debounce + poll_interval.
boot_check_timeout = 240
; Через сколько секунд отсутствия связи с NUT сообщить о проблеме.
comms_notify_after = 60

[display]
; Показывать на экране X11 предупреждение, таймер и кнопку остановки службы.
popup = yes
; Способ гашения: auto — X11 при наличии X-сокета, иначе консольный framebuffer.
backend = auto
; Номер графического дисплея X11.
name = :0
; При необходимости полный путь к файлу Xauthority, иначе оставить пустым.
xauthority =
; Как часто снова гасить монитор, если его включили мышью или программой, секунды.
refresh_interval = 30
