[Unit]
Description=UPS Guard - monitor UPS and protect this workstation
Wants=nut-server.service
After=nut-server.service
RequiresMountsFor="@PROJECT_DIR@"

[Service]
Type=simple
ExecStart=/usr/bin/python3 "@PROGRAM@" --config "@CONFIG@" run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
